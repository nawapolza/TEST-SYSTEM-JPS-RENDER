# Never commit real credentials. Set these in Render > Backend > Environment.
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/test_system_jps?retryWrites=true&w=majority
MONGODB_DB=test_system_jps
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRE_SECONDS=604800
PORT=3000
UPLOAD_MAX_MB=5
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=https://<your-frontend>.onrender.com
APP_TIMEZONE=Asia/Bangkok
# Optional: used only when seed_owner.js creates a missing account.
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_USER_PASSWORD=change-this-user-password
